# REVIVE — environment template
# Copy to .env and fill in. NEVER commit .env.
# All Razorpay credentials MUST be test-mode. Live mode requires explicit
# human authorization and is out of scope for this project.

# --- Razorpay (TEST MODE ONLY) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# --- LLM provider (pick one; see docs/DECISIONS.md D4) ---
ANTHROPIC_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://revive:revive@localhost:5432/revive

# --- App ---
ENV=development
LOG_LEVEL=INFO

# Enables the dev-only Failure Lab and webhook replay endpoints.
# MUST be false in any deployed environment.
ENABLE_DEV_ENDPOINTS=true
