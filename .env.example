# REVIVE — environment template
# Copy to .env and fill in. NEVER commit .env.
# All Razorpay credentials MUST be test-mode. Live mode requires explicit
# human authorization and is out of scope for this project.

# --- Razorpay (TEST MODE ONLY) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# --- LLM provider (see docs/DECISIONS.md D4) ---
# "google" uses Gemini's free tier (no card required):
#   aistudio.google.com/apikey
LLM_PROVIDER=google
GOOGLE_API_KEY=
# Optional override; blank uses the provider default.
LLM_MODEL=

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://revive:revive@localhost:5433/revive

# --- App ---
ENV=development
LOG_LEVEL=INFO

# Enables the dev-only Failure Lab and webhook replay endpoints.
# MUST be false in any deployed environment.
ENABLE_DEV_ENDPOINTS=false

# --- API security ---
# Required on mutating endpoints. Unset = requests are refused.
API_KEY=
# Dev surface: loopback-only even when true. Keep false unless testing.
ENABLE_DEV_ENDPOINTS=false
# Publicly advertising the API schema also advertises dev routes.
ENABLE_API_DOCS=false
